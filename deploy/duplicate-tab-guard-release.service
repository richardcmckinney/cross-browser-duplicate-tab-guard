[Unit]
Description=Release reviewed Duplicate Tab Guard main from the VSH user manager

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/duplicate-tab-guard-release.env
ExecStart=%h/.local/libexec/duplicate-tab-guard-release-runner
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
